# Every value below is optional — the server starts with working defaults.

# HTTP port. Render/Railway/Fly inject this automatically.
PORT=8080

# Where the JSON state file lives. Created and seeded on first start.
DATA_PATH=data/state.json

# Per-window play size. 18000 = the 5 hours the assignment requires.
# Drop it to e.g. 120 to watch a cycle restart during a demo.
CYCLE_SECONDS=18000

# How far ahead a sync is scheduled. This is what makes every window flip on
# the same tick instead of whenever its own message arrives.
SYNC_LEAD_MS=1200

# Fallback sync hold time when the client does not specify one.
SYNC_DEFAULT_SECONDS=10

# Comma-separated origins, or * for any.
ALLOWED_ORIGINS=*

# Point this at a built React bundle to serve the API and the UI from one
# process. Leave empty to run API-only.
STATIC_DIR=
