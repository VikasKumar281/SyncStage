# Leave empty (or delete this file) when the frontend is served from the same
# origin as the API — that covers both `npm run dev` (Vite proxies /api) and the
# single-container deployment.
#
# Set it only when the two are deployed separately, e.g. Vercel + Render:
# VITE_API_BASE_URL=https://SyncStage-api.onrender.com
VITE_API_BASE_URL=
